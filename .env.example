# Application Configuration
APP_DOMAIN_NAME=localhost
APP_NAME="GenericSuite CodeGen"

# Database Configuration
# "APP_DB_NAME" Defaults to: genericsuite_codegen
APP_DB_NAME=gs_codegen_dev
APP_DB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<DB_CLUSTER_NAME>.<DB_INSTANCE_NAME>.mongodb.net
# APP_DB_URI=mongodb://root:27017/?directConnection=true

# To turn off local MongoDb and mongoDb Express containers, set to 0
# USE_LOCAL_MONGODB=0

# Knowledgebase configuration
REMOTE_REPO_URL=https://github.com/tomkat-cr/genericsuite-basecamp.git
REMOTE_REPO_BRANCH=main
LOCAL_REPO_DIR=/absolute/path/to/local_repo_files
BASE_LOCAL_PATH=/absolute/path/to/local_repo_files/genericsuite-basecamp/docs
ALT_BASE_LOCAL_PATH=/var/local_repo_files/genericsuite-basecamp/docs
BASE_WEB_URL=https://genericsuite.carlosjramirez.com

# LLM Provider, Models and API keys

# API to use
LLM_API=openai
# LLM_API=litellm

# AI Model Provider
# LLM_PROVIDER=openai
# LLM_PROVIDER=huggingface
LLM_PROVIDER=aimlapi
# LLM_PROVIDER=groq
# LLM_PROVIDER=together
# LLM_PROVIDER=openrouter
# LLM_PROVIDER=xai
# LLM_PROVIDER=nvidia
# LLM_PROVIDER=together
# LLM_PROVIDER=ollama

## Use OpenAI
## https://platform.openai.com/api-keys
OPENAI_API_KEY=openai_api_key
## https://platform.openai.com/docs/pricing
## https://openai.com/api/pricing/
OPENAI_MODEL_NAME=gpt-4o-mini

## Use Huggingface
## https://huggingface.co/settings/tokens
HF_TOKEN=hf_token
## https://huggingface.co/models
HF_MODEL_NAME=moonshotai/Kimi-K2-Instruct-0905

## Use AI/ML API
## https://aimlapi.com/app/keys
AIMLAPI_API_KEY=aimlapi_api_key
## https://docs.aimlapi.com/api-overview/model-database/text-models
AIMLAPI_MODEL_NAME=deepseek/deepseek-non-reasoner-v3.1-terminus

## Use Groq
## https://console.groq.com/keys
GROQ_API_KEY=groq_api_key
## https://console.groq.com/docs/models
GROQ_MODEL_NAME=mixtral-8x7b-32768

## Use Together.ai
## https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=together_api_key
## https://api.together.xyz/models
TOGETHER_MODEL_NAME="meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo"

## Use OpenRouter
## https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=openrouter_api_key
## https://openrouter.ai/models
OPENROUTER_MODEL_NAME=google/gemini-2.0-flash-lite-001

## Use xAI (Grok)
## https://console.x.ai
XAI_API_KEY=xai_api_key
## https://docs.x.ai/docs/models?cluster=us-east-1
XAI_MODEL_NAME=grok-2

## Use Nvidia NIMs
## https://www.nvidia.com/en-us/account/
NVIDIA_API_KEY=nvidia_api_key
## https://build.nvidia.com/models
NVIDIA_MODEL_NAME=nvidia/llama-3.1-nemotron-70b-instruct

## Use Rhymes.ai
## https://rhymes.ai
RHYMES_API_KEY=rhymes_chat_api_key
## https://rhymes.ai/blog-details/aria-first-open-multimodal-native-moe-model
RHYMES_MODEL_NAME=aria

## Use Ollama
## https://ollama.com/search
OLLAMA_MODEL_NAME=gpt-oss:20b
# LLM_BASE_URL=http://localhost:11434/v1

# LLM Configuration
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=2024
LLM_TOP_P=1.0
LLM_TOP_K=50

# Embeddings Configuration
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_PROVIDER=huggingface
# EMBEDDINGS_MODEL=thenlper/gte-small

# Server Configuration
SERVER_PORT=8000
CORS_ORIGIN=localhost
SERVER_DEBUG=0

# MCP Server Configuration
MCP_API_KEY=gs_codegen_pk-123
MCP_SERVER_PORT=8070
MCP_SERVER_HOST=0.0.0.0

# UI Configuration
UI_PORT=3000
UI_SECURE_PORT=3001
UI_APP_DOMAIN_NAME=localhost
UI_API_BASE_URL=http://$UI_APP_DOMAIN_NAME:8000/v1
UI_API_BASE_URL_FOR_DOCKER=http://$UI_APP_DOMAIN_NAME:$UI_PORT/api/v1
UI_APP_SUBDIR=
UI_DEBUG=0

# Enhanced Search Configuration
ENHANCED_SEARCH_ENABLED=true
ENHANCED_SEARCH_CONFIG_FILE=enhanced_search_config.json
ENHANCED_SEARCH_TEMPLATES_FILE=search_templates.json
ENHANCED_SEARCH_MAX_CONTEXT_LENGTH=10000
ENHANCED_SEARCH_FALLBACK_ENABLED=true
ENHANCED_SEARCH_DUAL_SEARCH_ENABLED=true
ENHANCED_SEARCH_CONTEXT_DETERMINATION_ENABLED=true
ENHANCED_SEARCH_DOCUMENT_RETRIEVAL_ENABLED=true

# Document Retrieval Configuration
DOCUMENT_RETRIEVAL_MAX_FILE_SIZE_MB=10
DOCUMENT_RETRIEVAL_CACHE_ENABLED=true
DOCUMENT_RETRIEVAL_CACHE_TTL_SECONDS=3600

# Search Performance Configuration
SEARCH_MAX_CONCURRENT_SEARCHES=5
SEARCH_TIMEOUT_SECONDS=30
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=3600

# Context Determination Configuration
CONTEXT_DETERMINATION_CONFIDENCE_THRESHOLD=0.6
CONTEXT_DETERMINATION_DEFAULT_CONTEXT=generic

# Enhanced Search Logging
ENHANCED_SEARCH_LOG_LEVEL=INFO
ENHANCED_SEARCH_LOG_QUERIES=true
ENHANCED_SEARCH_LOG_DOCUMENT_RETRIEVAL=true
ENHANCED_SEARCH_LOG_CONTEXT_DETERMINATION=true
ENHANCED_SEARCH_LOG_PERFORMANCE_METRICS=true

# Logfire Configuration
# LOGFIRE_ENABLED=true
