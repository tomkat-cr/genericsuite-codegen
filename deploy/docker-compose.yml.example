# deploy/docker-compose.yml

services:
  gscodegen-server:
    container_name: gscodegen-server
    image: gscodegen_python
    command: sh -c "bash /var/scripts/server-entrypoint.sh"
    volumes:
      - ../server:/code/server
      - ../mcp-server:/code/mcp-server
      - ../server/genericsuite_codegen:/code/mcp-server/genericsuite_codegen
      - ./server-entrypoint.sh:/var/scripts/server-entrypoint.sh
      - ../.env:/var/scripts/.env
      - ../local_repo_files:/var/local_repo_files
    environment:
      # Common environment variables
      - APP_DOMAIN_NAME=${APP_DOMAIN_NAME}
      - APP_NAME=${APP_NAME}
      - APP_DB_URI=${APP_DB_URI}
      - APP_DB_NAME=${APP_DB_NAME}
      - REMOTE_REPO_URL=${REMOTE_REPO_URL}
      - LOCAL_REPO_DIR=${LOCAL_REPO_DIR}
      - BASE_LOCAL_PATH=${BASE_LOCAL_PATH}
      - BASE_WEB_URL=${BASE_WEB_URL}
      # LLM Configuration
      - LLM_API=${LLM_API}
      - LLM_PROVIDER=${LLM_PROVIDER}
      - LLM_MODEL_NAME=${LLM_MODEL_NAME}
      - LLM_BASE_URL=${LLM_BASE_URL}
      - LLM_TEMPERATURE=${LLM_TEMPERATURE}
      - LLM_MAX_TOKENS=${LLM_MAX_TOKENS}
      - LLM_TOP_P=${LLM_TOP_P}
      - LLM_TOP_K=${LLM_TOP_K}
      # LLM API keys and models
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - OPENAI_MODEL_NAME=${OPENAI_MODEL_NAME}
      - HF_TOKEN=${HF_TOKEN}
      - HF_MODEL_NAME=${HF_MODEL_NAME}
      - AIMLAPI_API_KEY=${AIMLAPI_API_KEY}
      - AIMLAPI_MODEL_NAME=${AIMLAPI_MODEL_NAME}
      - GROQ_API_KEY=${GROQ_API_KEY}
      - GROQ_MODEL_NAME=${GROQ_MODEL_NAME}
      - TOGETHER_API_KEY=${TOGETHER_API_KEY}
      - TOGETHER_MODEL_NAME=${TOGETHER_MODEL_NAME}
      - TOGETHER_STOP=${TOGETHER_STOP}
      - OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
      - OPENROUTER_MODEL_NAME=${OPENROUTER_MODEL_NAME}
      - XAI_API_KEY=${XAI_API_KEY}
      - XAI_MODEL_NAME=${XAI_MODEL_NAME}
      - NVIDIA_API_KEY=${NVIDIA_API_KEY}
      - NVIDIA_MODEL_NAME=${NVIDIA_MODEL_NAME}
      - RHYMES_API_KEY=${RHYMES_API_KEY}
      - RHYMES_MODEL_NAME=${RHYMES_MODEL_NAME}
      - OLLAMA_MODEL_NAME=${OLLAMA_MODEL_NAME}
      # Embeddings Configuration
      - EMBEDDINGS_PROVIDER=${EMBEDDINGS_PROVIDER}
      - EMBEDDINGS_MODEL=${EMBEDDINGS_MODEL}
      # Server environment variables
      - SERVER_PORT=${SERVER_PORT:-8002}
      - SERVER_DEBUG=${SERVER_DEBUG}
      - CORS_ORIGIN=${CORS_ORIGIN:-http://localhost:3002}
      # MCP Server environment variables
      - MCP_API_KEY=${MCP_API_KEY}
      - MCP_SERVER_PORT=${MCP_SERVER_PORT:-8072}
      - MCP_SERVER_HOST=${MCP_SERVER_HOST:-0.0.0.0}
      - MCP_TRANSPORT=http
    ports: ["8002:8002", "8072:8072"]
    # depends_on: [gscodegen-ollama]
    networks:
      - my_shared_network
    restart: unless-stopped

  gscodegen-client:
    container_name: gscodegen-client
    image: nginx:alpine
    volumes:
      - ../ui/dist:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    environment:
      - UI_PORT=${UI_PORT:-3002}
      - UI_SECURE_PORT=${UI_SECURE_PORT:-3003}
      - UI_APP_DOMAIN_NAME=${APP_DOMAIN_NAME}
      - UI_API_BASE_URL=${UI_API_BASE_URL_FOR_DOCKER:-http://localhost:3002/api}
      - UI_APP_SUBDIR=${UI_APP_SUBDIR}
      - UI_DEBUG=${UI_DEBUG}
    ports: ["3002:80", "3003:443"]
    depends_on: [gscodegen-server]
    networks:
      - my_shared_network
    restart: unless-stopped

  gscodegen-mongo:
    container_name: gscodegen-mongo-db
    # https://hub.docker.com/r/mongodb/mongodb-atlas-local
    # image: mongodb/mongodb-atlas-local
    image: gscodegen_mongo_db_atlas
    hostname: gscodegen-mongo
    restart: unless-stopped
    environment:
      # - MONGODB_INITDB_ROOT_USERNAME=root
      # - MONGODB_INITDB_ROOT_PASSWORD=example
      - MONGOD_LOG_FILE=/dev/null
      - MONGOT_LOG_FILE=/dev/null
      - RUNNER_LOG_FILE=/dev/null
    # Un-comment the following lines to persist data locally
    # (consider that MongoDB Atlas generates a lot of logs)
    # volumes:
    #   - ../local_mongodb_data/data:/data/db
    #   - ../local_mongodb_data/config:/data/configdb
    ports:
      - 27017:27017
    expose:
      - 27017
    networks:
      - my_shared_network
    profiles:
      - use_local_mongodb

  gscodegen-mongo-express:
    container_name: gscodegen-mongo-express
    image: mongo-express
    restart: unless-stopped
    ports:
      - 8081:8081
    environment:
      # - ME_CONFIG_MONGODB_ADMINUSERNAME=root
      # - ME_CONFIG_MONGODB_ADMINPASSWORD=example
      # - ME_CONFIG_MONGODB_URL=mongodb://root:example@gscodegen-mongo:27017/
      #
      - ME_CONFIG_MONGODB_URL=mongodb://gscodegen-mongo:27017/?directConnection=true
      # 
      # To access the MongoDB Express UI: http://localhost:8081
      # User: admin
      # Password: pass
      #
    depends_on: [gscodegen-mongo]
    networks:
      - my_shared_network
    profiles:
      - use_local_mongodb_express

  # gscodegen-ollama:
  #   container_name: gscodegen-ollama
  #   image: gscodegen_ollama
  #   environment:
  #     - OLLAMA_HOST=0.0.0.0
  #   restart: unless-stopped
  #   ports:
  #     - 11434:11434
  #   networks:
  #     - my_shared_network

networks:
  my_shared_network:
    external: true