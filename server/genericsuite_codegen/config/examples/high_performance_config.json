{
  "enhanced_search": {
    "enabled": true,
    "max_context_length": 20000,
    "fallback_enabled": true,
    "dual_search_enabled": true,
    "context_determination_enabled": true,
    "document_retrieval_enabled": true
  },
  "local_storage": {
    "local_repo_path": "local_repo_files",
    "max_file_size_mb": 50,
    "allowed_file_extensions": [
      ".md", ".py", ".js", ".jsx", ".ts", ".tsx", ".json", ".yaml", ".yml", 
      ".txt", ".rst", ".html", ".css", ".sh", ".toml", ".cfg", ".ini", ".log",
      ".sql", ".xml", ".csv", ".dockerfile"
    ],
    "excluded_directories": [
      ".git", "__pycache__", "node_modules", ".pytest_cache", 
      "dist", "build", ".vscode", ".idea", "logs", "tmp", "cache"
    ]
  },
  "search_performance": {
    "max_concurrent_searches": 20,
    "search_timeout_seconds": 120,
    "cache_enabled": true,
    "cache_ttl_seconds": 14400
  },
  "context_determination": {
    "confidence_threshold": 0.4,
    "default_context": "generic",
    "context_keywords": {
      "json": ["json", "configuration", "config", "table", "schema", "definition", "structure"],
      "langchain": ["langchain", "tool", "chain", "agent", "llm", "ai", "prompt"],
      "mcp": ["mcp", "server", "protocol", "model context", "stdio", "transport"],
      "frontend": ["react", "component", "ui", "frontend", "client", "vite", "webpack", "jsx", "tsx"],
      "backend": ["fastapi", "api", "server", "backend", "endpoint", "pydantic", "uvicorn", "gunicorn"],
      "frontend_ai": ["react", "ai", "chat", "llm", "frontend", "streaming", "websocket", "sse"],
      "backend_ai": ["fastapi", "ai", "agent", "llm", "backend", "pydantic", "openai", "anthropic"],
      "database": ["mongodb", "database", "collection", "query", "index", "aggregation"],
      "docker": ["docker", "dockerfile", "container", "compose", "image", "deployment"],
      "testing": ["test", "pytest", "unittest", "mock", "fixture", "coverage"]
    }
  },
  "logging": {
    "level": "DEBUG",
    "log_search_queries": true,
    "log_document_retrieval": true,
    "log_context_determination": true,
    "log_performance_metrics": true
  }
}