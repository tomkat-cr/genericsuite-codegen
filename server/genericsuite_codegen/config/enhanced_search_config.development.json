{
  "enhanced_search": {
    "enabled": true,
    "max_context_length": 15000,
    "fallback_enabled": true,
    "dual_search_enabled": true,
    "context_determination_enabled": true,
    "document_retrieval_enabled": true
  },
  "local_storage": {
    "local_repo_path": "local_repo_files",
    "max_file_size_mb": 20,
    "allowed_file_extensions": [
      ".md", ".py", ".js", ".jsx", ".ts", ".tsx", ".json", ".yaml", ".yml", 
      ".txt", ".rst", ".html", ".css", ".sh", ".toml", ".cfg", ".ini", ".log"
    ],
    "excluded_directories": [
      ".git", "__pycache__", "node_modules", ".pytest_cache", 
      "dist", "build", ".vscode", ".idea"
    ]
  },
  "search_performance": {
    "max_concurrent_searches": 10,
    "search_timeout_seconds": 60,
    "cache_enabled": true,
    "cache_ttl_seconds": 1800
  },
  "context_determination": {
    "confidence_threshold": 0.5,
    "default_context": "generic",
    "context_keywords": {
      "json": ["json", "configuration", "config", "table", "schema", "definition"],
      "langchain": ["langchain", "tool", "chain", "agent", "llm"],
      "mcp": ["mcp", "server", "protocol", "model context", "stdio"],
      "frontend": ["react", "component", "ui", "frontend", "client", "vite"],
      "backend": ["fastapi", "api", "server", "backend", "endpoint", "pydantic"],
      "frontend_ai": ["react", "ai", "chat", "llm", "frontend", "streaming"],
      "backend_ai": ["fastapi", "ai", "agent", "llm", "backend", "pydantic"]
    }
  },
  "logging": {
    "level": "DEBUG",
    "log_search_queries": true,
    "log_document_retrieval": true,
    "log_context_determination": true,
    "log_performance_metrics": true
  }
}