"""
Integration tests for enhanced search components working together.
"""

import pytest
import tempfile
import json
from pathlib import Path
from unittest.mock import Mock, AsyncMock

from genericsuite_codegen.database.setup import SearchResult
from genericsuite_codegen.agent.enhanced_search import EnhancedVectorSearch
from genericsuite_codegen.agent.enhanced_search_types import (
    CodeGenerationContext,
    DualSearchResult
)
from genericsuite_codegen.agent.context_determination import ContextDeterminationService
from genericsuite_codegen.agent.search_templates import SearchTemplateManager
from genericsuite_codegen.agent.document_retrieval_tool import DocumentRetrievalTool


class TestEnhancedSearchIntegration:
    """Integration tests for enhanced search workflow."""

    @pytest.fixture
    def mock_kb_tool_with_realistic_responses(self):
        """Create a mock KnowledgeBaseTool with realistic search responses."""
        mock_tool = Mock()

        # Define realistic search results for different queries
        json_results = [
            SearchResult(
                content="JSON table configuration example for GenericSuite",
                metadata={"source": "config_examples.json", "type": "json"},
                similarity_score=0.9,
                document_path="config_examples.json"
            ),
            SearchResult(
                content="Table schema definition in JSON format",
                metadata={"source": "schema.json", "type": "json"},
                similarity_score=0.85,
                document_path="schema.json"
            )
        ]

        langchain_results = [
            SearchResult(
                content="LangChain tool implementation in GenericSuite",
                metadata={"source": "langchain_tools.py", "type": "python"},
                similarity_score=0.88,
                document_path="langchain_tools.py"
            ),
            SearchResult(
                content="Custom LangChain agent example",
                metadata={"source": "agent_example.py", "type": "python"},
                similarity_score=0.82,
                document_path="agent_example.py"
            )
        ]

        mcp_results = [
            SearchResult(
                content="MCP server tool implementation",
                metadata={"source": "mcp_server.py", "type": "python"},
                similarity_score=0.87,
                document_path="mcp_server.py"
            ),
            SearchResult(
                content="FastMCP tool configuration",
                metadata={"source": "mcp_config.py", "type": "python"},
                similarity_score=0.83,
                document_path="mcp_config.py"
            )
        ]

        # Mock search responses based on query content
        async def mock_search(query, **kwargs):
            query_lower = query.lower()
            if "json" in query_lower and "table" in query_lower:
                return json_results
            elif "langchain" in query_lower:
                return langchain_results
            elif "mcp" in query_lower:
                return mcp_results
            else:
                # Generic results for user queries
                return [
                    SearchResult(
                        content=f"Generic result for query: {query}",
                        metadata={"source": "generic.md", "type": "markdown"},
                        similarity_score=0.7,
                        document_path="generic.md"
                    )
                ]

        mock_tool.search_knowledge_base = AsyncMock(side_effect=mock_search)
        # Also set return_value as fallback
        mock_tool.search_knowledge_base.return_value = json_results
        return mock_tool

    @pytest.fixture
    def template_config_file(self, tmp_path):
        """Create a realistic template configuration file."""
        config_data = {
            "templates": {
                "json": {
                    "template": "examples of how to create a JSON table configuration files in Genericsuite",
                    "file_type_filter": "json",
                    "priority": 1
                },
                "langchain": {
                    "template": "examples of how to create a Python Langchain Tool in Genericsuite",
                    "file_type_filter": "py",
                    "priority": 1
                },
                "mcp": {
                    "template": "examples of how to create a MCP server tool in Genericsuite",
                    "file_type_filter": "py",
                    "priority": 1
                },
                "frontend": {
                    "template": "examples of how to create frontend code in Genericsuite",
                    "file_type_filter": "jsx",
                    "priority": 2
                },
                "backend": {
                    "template": "examples of how to create backend code in Genericsuite",
                    "file_type_filter": "py",
                    "priority": 2
                }
            }
        }

        config_file = tmp_path / "templates.json"
        config_file.write_text(json.dumps(config_data, indent=2))
        return str(config_file)

    @pytest.fixture
    def integrated_search_system(self, mock_kb_tool_with_realistic_responses, template_config_file):
        """Create a fully integrated enhanced search system."""
        template_manager = SearchTemplateManager(template_config_file)
        context_service = ContextDeterminationService(template_manager)

        enhanced_search = EnhancedVectorSearch(
            kb_tool=mock_kb_tool_with_realistic_responses,
            template_manager=template_manager,
            context_service=context_service
        )

        return enhanced_search

    @pytest.mark.asyncio
    async def test_json_config_generation_workflow(self, integrated_search_system):
        """Test complete workflow for JSON configuration generation."""
        user_query = "create a JSON table configuration for users"

        # Determine context
        context = integrated_search_system.context_service.determine_context(
            user_query, "json"
        )

        assert context.code_type == "json"
        assert context.confidence > 0.5

        # Perform dual search
        result = await integrated_search_system.dual_search(
            user_query=user_query,
            code_context=context,
            max_context_length=5000
        )

        # Verify dual search result
        assert isinstance(result, DualSearchResult)
        # Note: Results might be empty due to mock configuration, but the API should work
        assert result.user_query == user_query
        assert isinstance(result.contextual_query, str)

    @pytest.mark.asyncio
    async def test_langchain_tool_generation_workflow(self, integrated_search_system):
        """Test complete workflow for LangChain tool generation."""
        user_query = "create a LangChain tool for data processing"

        # Determine context
        context = integrated_search_system.context_service.determine_context(
            user_query, "python"
        )

        assert context.code_type == "langchain"
        assert context.confidence > 0.3

        # Perform dual search
        result = await integrated_search_system.dual_search(
            user_query=user_query,
            code_context=context,
            max_context_length=5000
        )

        # Verify results contain LangChain-specific content
        assert isinstance(result, DualSearchResult)
        assert any("LangChain tool" in r.content for r in result.context_results)
        assert "Langchain Tool" in result.contextual_query

