    @pytest.mark.asyncio
    async def test_ambiguous_query_handling(self, integrated_search_system):
        """Test handling of ambiguous queries."""
        user_query = "create something useful"

        # Determine context
        context = integrated_search_system.context_service.determine_context(
            user_query, "unknown"
        )

        # Should have low confidence
        assert context.confidence < 0.5

        # Should still perform search
        result = await integrated_search_system.dual_search(
            user_query=user_query,
            code_context=context,
            max_context_length=5000
        )

        assert isinstance(result, DualSearchResult)
        # Should at least have user results
        assert len(result.user_results) > 0

    @pytest.mark.asyncio
    async def test_context_search_failure_fallback(self, integrated_search_system):
        """Test fallback behavior when contextual search fails."""
        # Mock contextual search to fail
        original_search = integrated_search_system.kb_tool.search_knowledge_base

        async def mock_search_with_failure(query, **kwargs):
            if "JSON table configuration" in query:
                raise Exception("Contextual search failed")
            return await original_search(query, **kwargs)

        integrated_search_system.kb_tool.search_knowledge_base = AsyncMock(
            side_effect=mock_search_with_failure
        )

        user_query = "create a JSON table configuration"
        context = CodeGenerationContext(code_type="json")

        # Should fallback to user results only
        result = await integrated_search_system.dual_search(
            user_query=user_query,
            code_context=context,
            max_context_length=5000
        )

        assert isinstance(result, DualSearchResult)
        assert len(result.user_results) > 0
        assert len(result.context_results) == 0
        assert result.merged_results == result.user_results

    @pytest.mark.asyncio
    async def test_result_deduplication_across_searches(self, integrated_search_system):
        """Test that duplicate results are properly deduplicated."""
        # Create a scenario where user and context searches return overlapping results
        duplicate_result = SearchResult(
            content="Duplicate content",
            metadata={"source": "duplicate.py", "type": "python"},
            similarity_score=0.8,
            document_path="duplicate.py"
        )

        async def mock_search_with_duplicates(query, **kwargs):
            return [duplicate_result]  # Both searches return the same result

        integrated_search_system.kb_tool.search_knowledge_base = AsyncMock(
            side_effect=mock_search_with_duplicates
        )

        user_query = "create a tool"
        context = CodeGenerationContext(code_type="python")

        result = await integrated_search_system.dual_search(
            user_query=user_query,
            code_context=context,
            max_context_length=5000
        )

        # Should deduplicate the results
        assert len(result.merged_results) == 1
        assert result.merged_results[0].chunk_id == "duplicate_1"

    @pytest.mark.asyncio
    async def test_context_length_limiting(self, integrated_search_system):
        """Test that context length is properly limited."""
        # Create large results that exceed context length
        large_results = []
        for i in range(10):
            result = SearchResult(
                content="x" * 1000,  # 1000 characters each
                metadata={"source": f"large_{i}.py", "type": "python"},
                similarity_score=0.8,
                document_path=f"large_{i}.py"
            )
            large_results.append(result)

        async def mock_search_large_results(query, **kwargs):
            return large_results

        integrated_search_system.kb_tool.search_knowledge_base = AsyncMock(
            side_effect=mock_search_large_results
        )

        user_query = "create a tool"
        context = CodeGenerationContext(code_type="python")

        result = await integrated_search_system.dual_search(
            user_query=user_query,
            code_context=context,
            max_context_length=3000  # Limit to 3000 characters
        )

        # Total content should be within limit
        total_content_length = sum(len(r.content)
                                   for r in result.merged_results)
        assert total_content_length <= 3000

    def test_document_retrieval_integration(self, temp_repo_dir):
        """Test integration with document retrieval tool."""
        # Create document retrieval tool
        doc_tool = DocumentRetrievalTool(temp_repo_dir)

        # Test retrieving documents that might be referenced in search results
        documents = doc_tool.retrieve_multiple_documents([
            "test.py",
            "config.json",
            "README.md"
        ])

        assert len(documents) == 3
        assert all(doc.content for doc in documents)

        # Test that retrieved documents can be used as additional context
        combined_content = "\n\n".join(doc.content for doc in documents)
        assert len(combined_content) > 0

    @pytest.mark.asyncio
    async def test_template_reloading_integration(self, integrated_search_system, template_config_file):
        """Test that template reloading works in integrated system."""
        # Perform initial search
        user_query = "create a custom tool"
        context = CodeGenerationContext(code_type="custom")

        # Should use default template for unknown type
        initial_query = integrated_search_system.context_service.get_contextual_search_query(
            context)

        # Update template configuration
        config_data = {
            "templates": {
                "custom": {
                    "template": "examples of custom tools in GenericSuite",
                    "file_type_filter": "py",
                    "priority": 1
                }
            }
        }

        Path(template_config_file).write_text(
            json.dumps(config_data, indent=2))

        # Reload templates
        integrated_search_system.template_manager.reload_templates()

        # Should now use new template
        updated_query = integrated_search_system.context_service.get_contextual_search_query(
            context)
        assert "custom tools" in updated_query

    @pytest.mark.asyncio
    async def test_error_recovery_and_logging(self, integrated_search_system):
        """Test error recovery and logging in integrated system."""
        # Mock search to fail intermittently
        call_count = 0

        async def mock_intermittent_failure(query, **kwargs):
            nonlocal call_count
            call_count += 1
            if call_count == 1:
                raise Exception("Temporary failure")
            return [
                SearchResult(
                    content="Recovery result",
                    metadata={"source": "recovery.py", "type": "python"},
                    score=0.8,
                    chunk_id="recovery_1"
                )
            ]

        integrated_search_system.kb_tool.search_knowledge_base = AsyncMock(
            side_effect=mock_intermittent_failure
        )

        user_query = "create a tool"
        context = CodeGenerationContext(code_type="python")

        # Should recover from first failure
        result = await integrated_search_system.dual_search(
            user_query=user_query,
            code_context=context,
            max_context_length=5000
        )

        # Should have results from recovery
        assert isinstance(result, DualSearchResult)
        assert len(result.user_results) == 0  # First call failed
        assert len(result.context_results) > 0  # Second call succeeded

    @pytest.mark.asyncio
    async def test_performance_with_realistic_load(self, integrated_search_system):
        """Test performance with realistic search load."""
        import time

        user_queries = [
            "create a JSON table configuration",
            "generate a LangChain tool",
            "build an MCP server tool",
            "create a React component",
            "generate a FastAPI endpoint"
        ]

        start_time = time.time()

        results = []
        for query in user_queries:
            context = integrated_search_system.context_service.determine_context(
                query, "auto"
            )
            result = await integrated_search_system.dual_search(
                user_query=query,
                code_context=context,
                max_context_length=5000
            )
            results.append(result)

        end_time = time.time()
        total_time = end_time - start_time

        # Should complete all searches in reasonable time
        assert total_time < 10.0  # 10 seconds max for 5 searches
        assert len(results) == 5
        assert all(isinstance(r, DualSearchResult) for r in results)
